// Enforce Zod 4 string format helpers instead of chaining off z.string()
or {
    // z.string().email() → z.email()
    `z.string().email($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.email() instead of z.string().email() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().email()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.email() instead of z.string().email() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().uuid() → z.uuid()
    `z.string().uuid($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.uuid() instead of z.string().uuid() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().uuid()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.uuid() instead of z.string().uuid() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().url() → z.url()
    `z.string().url($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.url() instead of z.string().url() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().url()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.url() instead of z.string().url() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().emoji() → z.emoji()
    `z.string().emoji($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.emoji() instead of z.string().emoji() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().emoji()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.emoji() instead of z.string().emoji() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().datetime() → z.iso.datetime()
    `z.string().datetime($args)` where {
        register_diagnostic(
            span = $match,
