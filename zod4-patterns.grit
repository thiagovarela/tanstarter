        )
    },
    `z.string().cuid()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.cuid() instead of z.string().cuid() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().cuid2() → z.cuid2()
    `z.string().cuid2($args)` where {
