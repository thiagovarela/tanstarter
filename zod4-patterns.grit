            message = "Use z.cuid2() instead of z.string().cuid2() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().cuid2()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.cuid2() instead of z.string().cuid2() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().ulid() → z.ulid()
    `z.string().ulid($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.ulid() instead of z.string().ulid() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().ulid()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.ulid() instead of z.string().ulid() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().nanoid() → z.nanoid()
    `z.string().nanoid($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.nanoid() instead of z.string().nanoid() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().nanoid()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.nanoid() instead of z.string().nanoid() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().jwt() → z.jwt()
    `z.string().jwt($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.jwt() instead of z.string().jwt() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().jwt()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.jwt() instead of z.string().jwt() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().cidr() → z.cidrv4() or z.cidrv6()
    `z.string().cidr($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.cidrv4() or z.cidrv6() instead of z.string().cidr() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().cidr()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.cidrv4() or z.cidrv6() instead of z.string().cidr() (Zod 4)",
            severity = "warn"
        )
    }
}
