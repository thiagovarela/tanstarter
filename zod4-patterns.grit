        )
    },
    `z.string().datetime()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.datetime() instead of z.string().datetime() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().date() → z.iso.date()
    `z.string().date($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.date() instead of z.string().date() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().date()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.date() instead of z.string().date() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().time() → z.iso.time()
    `z.string().time($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.time() instead of z.string().time() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().time()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.time() instead of z.string().time() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().duration() → z.iso.duration()
    `z.string().duration($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.duration() instead of z.string().duration() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().duration()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.iso.duration() instead of z.string().duration() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().base64() → z.base64()
    `z.string().base64($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.base64() instead of z.string().base64() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().base64()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.base64() instead of z.string().base64() (Zod 4)",
            severity = "warn"
        )
    },

    // z.string().ip() → z.ipv4() or z.ipv6()
    `z.string().ip($args)` where {
        register_diagnostic(
            span = $match,
            message = "Use z.ipv4() or z.ipv6() instead of z.string().ip() (Zod 4)",
            severity = "warn"
        )
    },
    `z.string().ip()` where {
        register_diagnostic(
            span = $match,
            message = "Use z.ipv4() or z.ipv6() instead of z.string().ip() (Zod 4)",
            severity = "warn"
        )
