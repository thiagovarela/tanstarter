{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"plugins": [
		"./no-manual-memoization.grit",
		"./no-dynamic-imports.grit",
		"./zod4-patterns.grit"
	],
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"!**/src/components/ui",
			"!**/src/components/ai-elements",
			"!**/src/server.ts",
			"!**/src/components/motion",
			"**/.vscode/**/*",
			"**/index.html",
			"**/vite.config.js",
			"!**/src/routeTree.gen.ts",
			"!**/src/styles.css"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"style": {
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"patterns": [
							{
								"group": [
									"@/lib/modules/*/managers",
									"@/lib/modules/*/managers.ts",
									"@/lib/modules/*/functions",
									"@/lib/modules/*/functions.ts",
									"@/lib/modules/*/durable",
									"@/lib/modules/*/durable.ts"
								],
								"message": "Import from module index.ts (client-safe), server.ts (server-only), or types.ts. Internal module files are private."
							}
						]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["**/src/lib/modules/**/*"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": [
				"**/src/lib/auth.ts",
				"**/src/lib/middleware.ts",
				"**/src/lib/restate-endpoints.ts",
				"**/src/routes/api/**/*.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		}
	]
}
