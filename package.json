{
  "name": "tanstarter-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --elide-lines=0 --filter @tanstarter/web dev --elide-lines=0",
    "build": "bun run --elide-lines=0 --filter @tanstarter/web build",
    "test": "bun run --elide-lines=0 --filter '*' test",
    "lint": "bun run --elide-lines=0 --filter '*' lint",
    "format": "bun run --elide-lines=0 --filter '*' format",
    "check": "bun run --elide-lines=0 -elide-lines=0 --filter '*' check ",
    "db:generate": "bun run --filter @tanstarter/data db:generate",
    "db:migrate": "bun run --filter @tanstarter/data db:migrate",
    "db:push": "bun run --filter @tanstarter/data db:push",
    "db:pull": "bun run --filter @tanstarter/data db:pull",
    "db:studio": "bun run --filter @tanstarter/data db:studio",
    "emails:dev": "bun run --filter @tanstarter/emails dev",
    "emails:build": "bun run --filter @tanstarter/emails build",
    "prepare": "husky",
    "restate:deploy": "bun run --filter @tanstarter/web restate:deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "^1.3.1",
    "@types/node": "^22.19.0",
    "dotenv": "^16.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "bunx biome format --write"
    ]
  }
}
